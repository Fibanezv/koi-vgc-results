# Desarrollo en Windows. Copia este archivo a .env para editarlo.
HOST=127.0.0.1
PORT=38470
PUBLIC_ORIGIN=http://127.0.0.1:38470

# Con ACCESS_CODES vacío, el servidor local genera un código temporal.
# Para un acceso fijo, indica un JSON por cuenta con códigos generados al azar.
# En producción configura ACCESS_CODES como secreto y usa un PUBLIC_ORIGIN HTTPS.
# ACCESS_CODES=

# DATA_DIR=data
# MEDIA_DIR=
